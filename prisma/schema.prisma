// 1. Cấu hình Generator và Datasource
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 2. Định nghĩa Models

model User {
  id            String   @id @default(dbgenerated("'USR' || LPAD(nextval('seq_user')::TEXT, 5, '0')")) @db.VarChar(20)
  name          String?  @db.VarChar(100)
  email         String   @unique @db.VarChar(100)
  accountStatus String?  @default("Active") @map("account_status") @db.VarChar(20)
  userType      String   @default("MENTEE") @map("user_type") @db.VarChar(10)
  department    String?  @db.VarChar(100)
  major         String?  @db.VarChar(100)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  // Quan hệ
  mentorProfile       MentorProfile?
  menteeConnections   MenteeConnection[] @relation("MenteeRel")
  mentorConnections   MenteeConnection[] @relation("MentorRel")
  createdEvents       CalendarEvent[]    @relation("EventCreator")
  eventAssignments    EventAssignment[]
  notifications       Notification[]
  progressRecords     ProgressRecord[]
  posts               Post[]
  comments            Comment[]
  reactions           Reaction[]
  reviewsGiven        Review[]           @relation("ReviewerRel")
  reviewsReceived     Review[]           @relation("MentorReviewRel")
  feedbackGiven       MentorFeedback[]   @relation("FeedbackMentorRel")
  feedbackReceived    MentorFeedback[]   @relation("FeedbackMenteeRel")
  ownedServers        ChatServer[]
  serverInvitations   ServerInvitation[] @relation("InvitedUser")
  sentInvitations     ServerInvitation[] @relation("Inviter")
  serverMemberships   ServerMember[]
  messages            Message[]
  chatConversations   ChatConversation[]

  @@map("user")
}

model MentorProfile {
  id           String   @id @default(dbgenerated("'MPR' || LPAD(nextval('seq_mentorprofile')::TEXT, 5, '0')")) @db.VarChar(20)
  userId       String   @unique @map("user_id") @db.VarChar(20)
  rating       Decimal  @default(0.00) @db.Decimal(3, 2)
  totalReviews Int      @default(0) @map("total_reviews")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  chuyenMon ChuyenMon[]
  lichTrong LichTrong[]

  @@map("mentor_profile")
}

model ChuyenMon {
  mentorId String @map("mentor_id") @db.VarChar(20)
  bangCap  String @map("bang_cap") @db.VarChar(255)

  mentor MentorProfile @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  @@id([mentorId, bangCap])
  @@map("chuyen_mon")
}

model LichTrong {
  maLichTrong Int      @id @default(autoincrement()) @map("ma_lich_trong")
  mentorId    String   @map("mentor_id") @db.VarChar(20)
  ngay        DateTime @db.Date
  gioBatDau   DateTime @map("gio_bat_dau") @db.Time(6)
  gioKetThuc  DateTime @map("gio_ket_thuc") @db.Time(6)

  mentor MentorProfile @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  @@map("lich_trong")
}

model MenteeConnection {
  id        String   @id @default(dbgenerated("'MCN' || LPAD(nextval('seq_menteeconnection')::TEXT, 5, '0')")) @db.VarChar(20)
  menteeId  String   @map("mentee_id") @db.VarChar(20)
  mentorId  String   @map("mentor_id") @db.VarChar(20)
  status    String   @default("PENDING") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  mentee User @relation("MenteeRel", fields: [menteeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  mentor User @relation("MentorRel", fields: [mentorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([menteeId, mentorId])
  @@map("mentee_connection")
}

model CalendarEvent {
  id          String   @id @default(dbgenerated("'EVT' || LPAD(nextval('seq_calendarevent')::TEXT, 5, '0')")) @db.VarChar(20)
  title       String   @db.VarChar(255)
  description String?  @db.Text
  startTime   DateTime @map("start_time") @db.Timestamp(6)
  endTime     DateTime @map("end_time") @db.Timestamp(6)
  priority    String   @default("MEDIUM") @db.VarChar(20)
  isCompleted Boolean  @default(false) @map("is_completed")
  creatorId   String   @map("creator_id") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  creator     User              @relation("EventCreator", fields: [creatorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignments EventAssignment[]
  reminders   EventReminder[]

  @@map("calendar_event")
}

model EventAssignment {
  id        String   @id @default(dbgenerated("'EAS' || LPAD(nextval('seq_eventassignment')::TEXT, 5, '0')")) @db.VarChar(20)
  eventId   String   @map("event_id") @db.VarChar(20)
  userId    String   @map("user_id") @db.VarChar(20)
  status    String   @default("PENDING") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  user     User          @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  calEvent CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@map("event_assignment")
}

model EventReminder {
  id           String   @id @default(dbgenerated("'RMD' || LPAD(nextval('seq_eventreminder')::TEXT, 5, '0')")) @db.VarChar(20)
  eventId      String   @map("event_id") @db.VarChar(20)
  reminderTime DateTime @map("reminder_time") @db.Timestamp(6)
  message      String?  @db.VarChar(255)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_reminder")
}

model Notification {
  id        String   @id @default(dbgenerated("'NTF' || LPAD(nextval('seq_notification')::TEXT, 5, '0')")) @db.VarChar(20)
  title     String   @db.VarChar(255)
  content   String   @db.Text
  isRead    Boolean  @default(false) @map("is_read")
  userId    String   @map("user_id") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("notification")
}

model ProgressRecord {
  id        String   @id @default(dbgenerated("'PRG' || LPAD(nextval('seq_progressrecord')::TEXT, 5, '0')")) @db.VarChar(20)
  menteeId  String   @map("mentee_id") @db.VarChar(20)
  score     Decimal  @db.Decimal(5, 2)
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  mentee User @relation(fields: [menteeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("progress_record")
}

model Post {
  id        String   @id @default(dbgenerated("'POST' || LPAD(nextval('seq_post')::TEXT, 5, '0')")) @db.VarChar(20)
  content   String   @db.Text
  authorId  String   @map("author_id") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  author    User       @relation(fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  images    Images[]
  comments  Comment[]
  reactions Reaction[]

  @@map("post")
}

model Images {
  id       String @id @default(dbgenerated("'IMG' || LPAD(nextval('seq_img')::TEXT, 5, '0')")) @db.VarChar(20)
  postId   String @map("post_id") @db.VarChar(20)
  imageUrl String @map("image_url") @db.VarChar(255)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("images")
}

model Comment {
  id        String   @id @default(dbgenerated("'CMT' || LPAD(nextval('seq_comment')::TEXT, 5, '0')")) @db.VarChar(20)
  content   String   @db.Text
  postId    String   @map("post_id") @db.VarChar(20)
  authorId  String   @map("author_id") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("comment")
}

model Reaction {
  id        String   @id @default(dbgenerated("'RCT' || LPAD(nextval('seq_reaction')::TEXT, 5, '0')")) @db.VarChar(20)
  type      String   @db.VarChar(20)
  postId    String   @map("post_id") @db.VarChar(20)
  userId    String   @map("user_id") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([postId, userId])
  @@map("reaction")
}

model Review {
  id         String   @id @default(dbgenerated("'RVW' || LPAD(nextval('seq_review')::TEXT, 5, '0')")) @db.VarChar(20)
  reviewerId String   @map("reviewer_id") @db.VarChar(20)
  mentorId   String   @map("mentor_id") @db.VarChar(20)
  rating     Int
  comment    String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  reviewer User @relation("ReviewerRel", fields: [reviewerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  mentor   User @relation("MentorReviewRel", fields: [mentorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("review")
}

model MentorFeedback {
  id        String   @id @default(dbgenerated("'FDB' || LPAD(nextval('seq_mentorfeedback')::TEXT, 5, '0')")) @db.VarChar(20)
  mentorId  String   @map("mentor_id") @db.VarChar(20)
  menteeId  String   @map("mentee_id") @db.VarChar(20)
  score     Int?
  comment   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  mentor User @relation("FeedbackMentorRel", fields: [mentorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  mentee User @relation("FeedbackMenteeRel", fields: [menteeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("mentor_feedback")
}

model ChatServer {
  id          String   @id @default(dbgenerated("'SRV' || LPAD(nextval('seq_chatserver')::TEXT, 5, '0')")) @db.VarChar(20)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  image       String?  @db.VarChar(500)
  ownerId     String   @map("owner_id") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  owner       User               @relation(fields: [ownerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invitations ServerInvitation[]
  members     ServerMember[]
  channels    Channel[]

  @@map("chat_server")
}

model ServerInvitation {
  id            String   @id @default(dbgenerated("'INV' || LPAD(nextval('seq_serverinvitation')::TEXT, 5, '0')")) @db.VarChar(20)
  serverId      String   @map("server_id") @db.VarChar(20)
  invitedUserId String   @map("invited_user_id") @db.VarChar(20)
  invitedById   String   @map("invited_by_id") @db.VarChar(20)
  status        String   @default("PENDING") @db.VarChar(20)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  server      ChatServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  invitedUser User       @relation("InvitedUser", fields: [invitedUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inviter     User       @relation("Inviter", fields: [invitedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([serverId, invitedUserId])
  @@map("server_invitation")
}

model ServerMember {
  id        String   @id @default(dbgenerated("'MBR' || LPAD(nextval('seq_servermember')::TEXT, 5, '0')")) @db.VarChar(20)
  serverId  String   @map("server_id") @db.VarChar(20)
  userId    String   @map("user_id") @db.VarChar(20)
  role      String   @default("MEMBER") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  server ChatServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([serverId, userId])
  @@map("server_member")
}

model Channel {
  id          String   @id @default(dbgenerated("'CHN' || LPAD(nextval('seq_channel')::TEXT, 5, '0')")) @db.VarChar(20)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  serverId    String   @map("server_id") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  server   ChatServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([serverId, name])
  @@map("channel")
}

model Message {
  id        String   @id @default(dbgenerated("'MSG' || LPAD(nextval('seq_message')::TEXT, 5, '0')")) @db.VarChar(20)
  content   String?  @db.Text
  authorId  String   @map("author_id") @db.VarChar(20)
  channelId String   @map("channel_id") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  author  User    @relation(fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  files   File[]

  @@map("message")
}

model File {
  id        String   @id @default(dbgenerated("'FIL' || LPAD(nextval('seq_file')::TEXT, 5, '0')")) @db.VarChar(20)
  name      String   @db.VarChar(255)
  url       String   @db.VarChar(500)
  size      BigInt
  messageId String   @map("message_id") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("file")
}

model ChatConversation {
  id        String   @id @default(dbgenerated("'CNV' || LPAD(nextval('seq_chatconversation')::TEXT, 5, '0')")) @db.VarChar(20)
  userId    String   @map("user_id") @db.VarChar(20)
  title     String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@map("chat_conversation")
}

model ChatMessage {
  id             String   @id @default(dbgenerated("'CHM' || LPAD(nextval('seq_chatmessage')::TEXT, 5, '0')")) @db.VarChar(20)
  conversationId String   @map("conversation_id") @db.VarChar(20)
  content        String   @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("chat_message")
}